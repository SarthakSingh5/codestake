{
  "manifest_version": 3,
  "name": "CodeStake - Hardcore LeetCode",
  "version": "1.0.0",
  "description": "Put real money on the line while practicing LeetCode.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "CodeStake",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://leetcode.com/*"],
      "js": ["src/content.tsx"]
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/website-sync.ts"]
    }
  ],
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://codestake-zeta.vercel.app/*",
    "http://localhost/*"
  ],
  "externally_connectable": {
    "matches": [
      "https://codestake-zeta.vercel.app/*",
      "http://localhost/*",
      "*://localhost/*"
    ]
  },
  "web_accessible_resources": [
    {
      "resources": ["src/interceptor.js"],
      "matches": ["*://leetcode.com/*"]
    }
  ]
}
